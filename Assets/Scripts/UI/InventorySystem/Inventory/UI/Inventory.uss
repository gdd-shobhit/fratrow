.container {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    flex-grow: 1;
    width: auto;
    height: auto;
    max-width: none;
    max-height: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-shadow: 2px 2px 2px rgba(0, 0, 0, 0.5);
    color: rgb(255, 0, 236);
}

.container.edit-mode .inventory {
    border-color: rgb(255, 0, 236);
}

.inventory {
    flex-direction: row;
    width: auto;
    padding: 8px 12px;
    align-items: center;
    justify-content: center;
    flex-grow: 0;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 8px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.25);
    background-image: none;
}

.inventoryHeader {
    display: none;
}

Label {
    font-size: 24px;
}

.inventoryFrame {
    display: none;
}

.slotsContainer {
    flex-grow: 0;
    padding-top: 0;
    flex-wrap: nowrap;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

.slot {
    width: 60px;
    height: 60px;
    margin: 4px;
}

.slotFrame {
    position: absolute;
    top: 0;
    left: 0;
    width: 60px;
    height: 60px;
    border-width: 0;
    -unity-slice-scale: 0.8;
    background-image: url("project://database/Assets/Space_Exploration_GUI_Kit/Grid_Components/Large/item-info-picto-icon-container-large.png?fileID=2800000&guid=64c4e7c4890c2eb4e80dc959a2c3aa60&type=3#item-info-picto-icon-container-large");
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

.slotIcon {
    padding: 4px;
    flex-shrink: 0;
    flex-grow: 1;
}

.stackCount {
    position: absolute;
    color: white;
    bottom: 0;
    right: 0;
    font-size: 18px;
}

.ghostIcon {
    visibility: hidden;
    position: absolute;
    width: 60px;
    height: 60px;
    background-image: none;
}

.coins {
    display: none;
}

.coinsIcon {
    display: none;
}

.slot:hover {
    width: 60px;
    height: 60px;
    margin: 4px;
    background-image: url("project://database/Assets/Space_Exploration_GUI_Kit/Grid_Components/Large/inventory-highlight-large%201.png?fileID=2800000&guid=84af1e1dff4d84e4da23b7114a108818&type=3#inventory-highlight-large 1");
}

.slot.equipped .slotFrame {
    -unity-background-image-tint-color: rgb(255, 0, 236);
}
