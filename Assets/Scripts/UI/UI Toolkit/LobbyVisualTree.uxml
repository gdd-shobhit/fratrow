<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/UI/UI%20Toolkit/HUD.uss?fileID=7433441132597879392&amp;guid=f7e6951f4b372b04c94db46206129a66&amp;type=3#HUD"/>
    <Style src="project://database/Assets/Scripts/UI/UI%20Toolkit/Lobby.uss?fileID=7433441132597879392&amp;guid=8eef0b0314dc4190b9c488d0b0526a4f&amp;type=3#Lobby"/>
    <!-- Same panels, eyebrows, meters and chips as the in-game HUD (HUD.uss). The centre stays clear for the 3D player previews. -->
    <ui:VisualElement name="Container" picking-mode="Ignore" class="lobby-root">
        <!-- Top centre: session code and ready count (shaped like the in-game phase banner). -->
        <ui:VisualElement name="LobbyBanner" class="hud-phase-banner">
            <ui:VisualElement class="hud-phase-row">
                <ui:Label text="LOBBY" name="Header" class="hud-phase-name lobby-banner-title"/>
                <ui:Label text="·" class="hud-phase-sep"/>
                <ui:Label text="Session code" name="SessionCodeLabel" class="hud-phase-caption"/>
                <ui:Label text="----" name="SessionCode" class="lobby-session-code"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-phase-row hud-phase-row--sub">
                <ui:Label text="Ready 0/0" name="ReadyCount" class="hud-ready lobby-ready-count"/>
                <ui:Label text="·" class="hud-phase-sep lobby-sep--small"/>
                <ui:Label text="Waiting for players..." name="LobbyStatus" class="hud-phase-caption"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Left column: the fraternity (host names it) and who's in the lobby. -->
        <ui:VisualElement name="LeftColumn" class="lobby-left-column">
            <ui:VisualElement name="FratIdentity" class="frat-identity-panel lobby-frat">
                <ui:Label text="FRATERNITY" class="frat-identity-eyebrow"/>
                <ui:TextField name="FratNameField" max-length="32" placeholder-text="Name your house" class="lobby-field lobby-field--frat"/>
                <ui:Label text="Unnamed house" name="FratNameLabel" class="frat-identity-name lobby-frat-name" style="display: none;"/>
                <ui:Label text="Only you (the host) can name the house." name="FratNameHint" class="hud-muted lobby-hint"/>
            </ui:VisualElement>
            <ui:VisualElement name="PlayerListContainer" class="hud-panel">
                <ui:VisualElement class="hud-panel-header">
                    <ui:Label text="PLAYERS" name="PlayerListHeader" class="hud-eyebrow"/>
                    <ui:Label text="0/4" name="PlayerCount" class="hud-quickstat-value"/>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerList" class="lobby-player-list"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Right column: your name, class (with its stats) and look. -->
        <ui:VisualElement name="RightColumn" class="lobby-right-column">
            <ui:VisualElement name="AppearanceContainer" class="hud-panel">
                <ui:Label text="YOU" class="hud-eyebrow"/>
                <ui:VisualElement name="Name" class="lobby-field-row">
                    <ui:Label text="NAME" name="PlayerNameLabel" class="hud-stat-caption lobby-field-caption"/>
                    <ui:TextField name="PlayerNameField" max-length="24" class="lobby-field"/>
                </ui:VisualElement>
                <ui:VisualElement name="ClassSelectionContainer" class="lobby-field-row">
                    <ui:Label text="CLASS" name="ClassSelectionLabel" class="hud-stat-caption lobby-field-caption"/>
                    <ui:DropdownField name="ClassDropdown" choices="President,SocialChair,Chad,RichGuy" value="President" class="lobby-dropdown"/>
                </ui:VisualElement>
                <ui:Label text="CLASS STATS" class="hud-eyebrow hud-eyebrow--spaced"/>
                <ui:VisualElement name="PlayerStats">
                    <ui:VisualElement class="hud-meter-row">
                        <ui:Label text="Popularity" class="hud-meter-caption"/>
                        <ui:VisualElement class="hud-meter">
                            <ui:VisualElement name="PopularityFill" class="hud-meter__fill hud-meter__fill--hype"/>
                        </ui:VisualElement>
                        <ui:Label text="0" name="PopularityValue" class="hud-meter-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-meter-row">
                        <ui:Label text="Trouble" class="hud-meter-caption"/>
                        <ui:VisualElement class="hud-meter">
                            <ui:VisualElement name="TroubleMakerFill" class="hud-meter__fill hud-meter__fill--warn"/>
                        </ui:VisualElement>
                        <ui:Label text="0" name="TroubleMakerValue" class="hud-meter-value"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="hud-meter-row">
                        <ui:Label text="Cash" class="hud-meter-caption"/>
                        <ui:VisualElement class="hud-meter">
                            <ui:VisualElement name="CashFill" class="hud-meter__fill lobby-meter__fill--cash"/>
                        </ui:VisualElement>
                        <ui:Label text="0" name="CashValue" class="hud-meter-value"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="LookPanel" class="hud-panel">
                <ui:Label text="LOOK" class="hud-eyebrow"/>
                <ui:VisualElement name="SkinCycler" class="lobby-cycler">
                    <ui:Button text="‹" name="SkinLeftArrow" class="lobby-cycler-arrow"/>
                    <ui:VisualElement class="lobby-cycler-text">
                        <ui:Label text="FIT" class="hud-stat-caption"/>
                        <ui:Label text="Select Fit" name="SkinLabel" class="lobby-cycler-value"/>
                    </ui:VisualElement>
                    <ui:Button text="›" name="SkinRightArrow" class="lobby-cycler-arrow"/>
                </ui:VisualElement>
                <ui:VisualElement name="BodyCycler" class="lobby-cycler">
                    <ui:Button text="‹" name="MeshLeftArrow" class="lobby-cycler-arrow"/>
                    <ui:VisualElement class="lobby-cycler-text">
                        <ui:Label text="BODY TYPE" class="hud-stat-caption"/>
                        <ui:Label text="Select Body Type" name="MeshLabel" class="lobby-cycler-value"/>
                    </ui:VisualElement>
                    <ui:Button text="›" name="MeshRightArrow" class="lobby-cycler-arrow"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <!-- Bottom centre: the same three buttons as before. -->
        <ui:VisualElement name="ButtonContainer" class="lobby-action-bar">
            <ui:Button text="Ready" name="ReadyButton" class="lobby-button lobby-button--primary"/>
            <ui:Button text="Start Game" name="StartGameButton" class="lobby-button lobby-button--start"/>
            <ui:Button text="Leave Lobby" name="LeaveButton" class="lobby-button"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
