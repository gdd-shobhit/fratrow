.shop-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.65);
}

.shop-panel {
    flex-direction: column;
    min-width: 480px;
    max-width: 720px;
    max-height: 85%;
    padding: 24px;
    background-color: rgba(32, 32, 40, 0.95);
    border-radius: 12px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.15);
}

.shop-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 16px;
    min-height: 48px;
}

.shop-title {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}

.shop-close {
    min-width: 100px;
    height: 158px;
    font-size: 20px;
}

.shop-scroll {
    flex-grow: 1;
    min-height: 200px;
    max-height: 520px;
}

.shop-scroll > #unity-content-container {
    flex-direction: column;
    padding: 4px;
}

.shop-item-icon-wrap {
    width: 64px;
    height: 64px;
    flex-shrink: 0;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.shop-item-icon {
    width: 56px;
    height: 56px;
}

.shop-item-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    padding: 10px 12px;
    margin-bottom: 8px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.shop-item-row--selected {
    border-color: rgba(255, 200, 80, 0.5);
    background-color: rgba(40, 35, 20, 0.5);
}

.shop-item-main {
    flex-direction: column;
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 160px;
}

.shop-item-name {
    font-size: 20px;
    color: rgb(255, 255, 255);
}

.shop-item-tags-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 6px;
}

.shop-item-economy-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 4px;
}

.shop-item-rarity {
    font-size: 14px;
    margin-right: 12px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0.35);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    -unity-text-align: upper-center;
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
}

.shop-item-type {
    font-size: 14px;
    margin-right: 12px;
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    padding-top: 8px;
    padding-right: 10px;
    padding-bottom: 8px;
    padding-left: 10px;
}

.shop-item-cost,
.shop-item-stock {
    font-size: 15px;
    color: rgb(200, 200, 210);
    margin-right: 12px;
}

.shop-buy {
    font-size: 16px;
    margin-left: 8px;
    min-height: 70%;
    max-width: 30%;
}

.shop-buy:disabled {
    opacity: 0.45;
}

.rarity-common {
    color: rgb(180, 180, 190);
}

.rarity-uncommon {
    color: rgb(80, 200, 120);
}

.rarity-rare {
    color: rgb(80, 160, 255);
}

.rarity-epic {
    color: rgb(200, 100, 255);
}

.rarity-legendary {
    color: rgb(255, 160, 60);
}

.item-type-alcohol {
    color: rgb(220, 140, 110);
}

.item-type-food {
    color: rgb(240, 190, 100);
}

.item-type-mixer {
    color: rgb(120, 220, 200);
}

.item-type-drinks {
    color: rgb(130, 200, 255);
}

.item-type-misc {
    color: rgb(170, 175, 190);
}

.item-type-fruits {
    color: rgb(255, 130, 150);
}

.item-type-herbs-spices-aromatics {
    color: rgb(110, 200, 130);
}

.item-type-sweeteners {
    color: rgb(255, 215, 235);
}

.item-type-liqueurs {
    color: rgb(190, 130, 230);
}
