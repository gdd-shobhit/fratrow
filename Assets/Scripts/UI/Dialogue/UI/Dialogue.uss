.dialogue-root {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    top: 0;
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 48px;
}

.dialogue-panel {
    width: 720px;
    max-width: 90%;
    background-color: rgba(12, 14, 20, 0.92);
    border-radius: 12px;
    padding: 20px 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.dialogue-speaker {
    color: rgb(255, 210, 120);
    font-size: 18px;
    margin-bottom: 8px;
    -unity-font-style: bold;
}

.dialogue-body {
    color: rgb(235, 235, 240);
    font-size: 16px;
    white-space: normal;
    margin-bottom: 16px;
    min-height: 48px;
}

.dialogue-continue {
    align-self: flex-end;
    padding: 8px 18px;
    background-color: rgb(60, 90, 160);
    color: white;
    border-radius: 6px;
}

.dialogue-options {
    flex-direction: column;
}

.dialogue-option {
    margin-top: 8px;
    padding: 10px 14px;
    background-color: rgb(40, 48, 68);
    color: white;
    border-radius: 6px;
    white-space: normal;
}
