.phone-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.45);
}

/* Layer 1 — case chrome (swap background-image later) */
.phone-case {
    width: 320px;
    height: 620px;
    padding: 18px;
    border-radius: 36px;
    background-color: rgb(36, 36, 42);
    border-width: 2px;
    border-color: rgb(70, 70, 80);
    background-image: url("project://database/Assets/UI/Phone/Placeholders/phone_case.png");
    -unity-background-scale-mode: stretch-to-fill;
    justify-content: center;
    align-items: stretch;
}

/* Layer 2 — screen / wallpaper */
.phone-screen {
    flex-grow: 1;
    border-radius: 24px;
    background-color: rgb(18, 22, 30);
    background-image: url("project://database/Assets/UI/Phone/Placeholders/phone_screen.png");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
    flex-direction: column;
    padding: 8px;
}

.phone-status-bar {
    flex-direction: row;
    height: 36px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 6px;
}

.phone-status {
    flex-grow: 1;
    -unity-text-align: middle-center;
    color: rgb(220, 220, 230);
    font-size: 13px;
}

.phone-nav-back,
.phone-close {
    width: 36px;
    height: 28px;
    margin: 0;
    padding: 0;
    font-size: 16px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 0;
    border-radius: 6px;
    color: rgb(230, 230, 240);
}

/* Layer 3 — apps host */
.phone-apps {
    flex-grow: 1;
    flex-direction: column;
}

.phone-view {
    flex-grow: 1;
    flex-direction: column;
}

.app-title {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(245, 245, 250);
    margin-bottom: 10px;
    margin-left: 4px;
}

.home-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
    padding: 8px;
}

.app-icon {
    width: 96px;
    height: 96px;
    margin: 8px;
    border-radius: 18px;
    border-width: 0;
    color: rgb(255, 255, 255);
    font-size: 13px;
    -unity-font-style: bold;
    background-color: rgb(60, 70, 90);
}

.app-icon-contacts {
    background-color: rgb(50, 110, 190);
    background-image: url("project://database/Assets/UI/Phone/Placeholders/app_contacts.png");
    -unity-background-scale-mode: scale-to-fit;
}

.app-icon-messages {
    background-color: rgb(40, 150, 90);
    background-image: url("project://database/Assets/UI/Phone/Placeholders/app_messages.png");
    -unity-background-scale-mode: scale-to-fit;
}

.phone-scroll {
    flex-grow: 1;
}

.contact-row {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    margin-bottom: 6px;
    border-radius: 12px;
    background-color: rgba(255, 255, 255, 0.06);
}

.contact-avatar {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    margin-right: 10px;
    background-color: rgb(120, 120, 130);
    background-image: url("project://database/Assets/UI/Phone/Placeholders/avatar_placeholder.png");
    -unity-background-scale-mode: stretch-to-fill;
    flex-shrink: 0;
}

.contact-text {
    flex-grow: 1;
    flex-direction: column;
}

.contact-name {
    color: rgb(245, 245, 250);
    font-size: 15px;
    -unity-font-style: bold;
}

.contact-tag {
    color: rgb(160, 170, 190);
    font-size: 11px;
    margin-top: 2px;
}

.contact-preview {
    color: rgb(140, 150, 165);
    font-size: 11px;
    margin-top: 2px;
    white-space: normal;
}

.thread-scroll {
    margin-bottom: 8px;
}

.msg-bubble {
    max-width: 85%;
    padding: 8px 12px;
    margin-bottom: 6px;
    border-radius: 14px;
    font-size: 13px;
    white-space: normal;
}

.msg-bubble-out {
    align-self: flex-end;
    background-color: rgb(40, 120, 220);
    color: rgb(255, 255, 255);
}

.msg-bubble-in {
    align-self: flex-start;
    background-color: rgba(255, 255, 255, 0.12);
    color: rgb(230, 230, 240);
}

.template-row {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: 4px;
}

.template-btn {
    flex-grow: 1;
    margin: 2px;
    height: 36px;
    border-radius: 10px;
    border-width: 0;
    background-color: rgba(255, 255, 255, 0.1);
    color: rgb(230, 230, 240);
    font-size: 12px;
}

.template-btn-invite {
    background-color: rgb(50, 140, 80);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
}

.weekend-row {
    margin-top: 12px;
    flex-direction: column;
}

.weekend-btn {
    margin-top: 6px;
    height: 36px;
    background-color: rgb(50, 90, 140);
    color: white;
    border-radius: 8px;
}

.weekend-btn-host {
    background-color: rgb(140, 80, 40);
}

.weekend-status {
    margin-top: 6px;
    color: rgb(180, 190, 210);
    font-size: 12px;
    -unity-text-align: middle-center;
}
