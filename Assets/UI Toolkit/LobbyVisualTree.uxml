<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=a19dac0e7ce2b3944858e48ca0245d28&amp;type=3#MainMenuStyle"/>
    <Style src="project://database/Assets/UI%20Toolkit/HUD.uss?fileID=7433441132597879392&amp;guid=f7e6951f4b372b04c94db46206129a66&amp;type=3#HUD"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; align-self: flex-start; width: 1922px; background-image: none; -unity-background-scale-mode: stretch-to-fill;">
        <ui:Label text="Lobby" name="Header" class="header" style="-unity-font-definition: url(&quot;project://database/Assets/Space_Exploration_GUI_Kit/Fonts/Font%20Sources/static/Asap_SemiCondensed-SemiBold.ttf?fileID=12800000&amp;guid=53c38cca34deaed409f0e16ea9c6afe0&amp;type=3#Asap_SemiCondensed-SemiBold&quot;); font-size: 80px; -unity-text-align: upper-center; -unity-text-outline-width: 0; text-shadow: 0 0 5px rgb(255, 255, 255); color: rgb(255, 0, 116); letter-spacing: 1px; word-spacing: 2px; background-color: rgba(255, 255, 255, 0); background-image: none; text-overflow: ellipsis;"/>
        <ui:VisualElement name="SessionCodeContainer" style="flex-direction: row; align-items: center; justify-content: center; margin-top: 20px;">
            <ui:Label text="Session Code:" name="SessionCodeLabel" style="font-size: 24px; color: white; margin-right: 10px;"/>
            <ui:Label text="----" name="SessionCode" style="font-size: 32px; font-weight: bold; color: rgb(255, 255, 0); background-color: rgba(0, 0, 0, 0.5); padding: 10px 20px; border-radius: 5px;"/>
        </ui:VisualElement>
        <ui:VisualElement style="flex-grow: 1; flex-direction: row; width: 100%;">
            <ui:VisualElement name="PlayerListContainer" style="flex-grow: 1; align-items: center; margin-top: 40px; margin-left: 80px; align-self: flex-start; margin-right: 80px; width: 10%; height: 389px;">
                <ui:Label text="Players" name="PlayerListHeader" style="font-size: 36px; color: white; margin-bottom: 20px;"/>
                <ui:VisualElement name="PlayerList" style="flex-direction: column; align-items: center; width: 80%; background-color: rgba(0, 0, 0, 0.3); padding: 20px; border-radius: 10px; align-self: center; align-content: center; justify-content: space-between;"/>
            </ui:VisualElement>
            <ui:VisualElement name="AppearanceContainer" style="flex-grow: 1; height: 500px; align-self: center; align-content: auto; justify-content: center; align-items: center; flex-direction: column; width: 30%; flex-shrink: 1; flex-wrap: nowrap; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
                <ui:VisualElement name="Name" style="flex-grow: 1; flex-direction: row; align-self: auto; width: 50%; height: 50%; flex-wrap: wrap; justify-content: flex-start; align-content: auto; align-items: center;">
                    <ui:Label text="Your Name:" name="PlayerNameLabel" style="font-size: 24px; color: white; margin-right: 10px; height: 47px;"/>
                    <ui:TextField name="PlayerNameField" value="" max-length="24" style="width: 240px; font-size: 18px; -unity-text-outline-width: 1px; -unity-font-style: bold; overflow: hidden; color: rgb(0, 0, 0); height: 54px;"/>
                </ui:VisualElement>
                <ui:VisualElement name="ClassSelectionContainer" style="flex-direction: row; align-items: center; justify-content: flex-start; margin-top: 30px; margin-bottom: 30px; align-content: auto; align-self: auto; width: 50%; height: 50%;">
                    <ui:Label text="Select Class:" name="ClassSelectionLabel" style="font-size: 24px; color: white; margin-right: 20px; height: 34px;"/>
                    <ui:DropdownField name="ClassDropdown" choices="President,SocialChair,Chad,RichGuy" value="President" data-source="" style="width: 200px; background-image: none;"/>
                </ui:VisualElement>
                <ui:VisualElement name="PlayerStats" style="flex-grow: 1; width: 40%; translate: 0% 0%; align-items: flex-start; justify-content: flex-start; align-self: center;">
                    <ui:Label text="Popularity" name="Label"/>
                    <ui:Slider label="Slider" value="80" high-value="100" name="Popularity" fill="true" show-input-field="false" inverted="true" low-value="0" class="HUDSlider bar" style="background-image: none; background-color: rgba(0, 0, 0, 0); flex-direction: row-reverse; margin-bottom: 20px; margin-top: 20px;">
                        <ui:Image name="Image_Pop" source="project://database/Assets/Space_Exploration_GUI_Kit/Icons/gem-1-512.png?fileID=2800000&amp;guid=e93aaa7f86f3d884ca8cefa5d8dfa6b2&amp;type=3#gem-1-512" scale-mode="ScaleToFit" style="width: 10%; height: 100%; translate: 70% 0%; margin-right: 4px; scale: 2 2 2;"/>
                    </ui:Slider>
                    <ui:Slider label="Slider" value="57.9" high-value="100" name="TroubleMaker" fill="true" show-input-field="false" inverted="true" class="HUDSlider bar" style="flex-direction: row-reverse; margin-bottom: 20px;">
                        <ui:Image name="Image" source="project://database/Assets/Space_Exploration_GUI_Kit/Icons/skull-512.png?fileID=2800000&amp;guid=d18286f1fadb5e545bf2a031b0bf2196&amp;type=3#skull-512" scale-mode="ScaleToFit" style="width: 10%; height: 100%; translate: 70% 0%; margin-right: 4px; scale: 2 2;"/>
                    </ui:Slider>
                    <ui:Slider label="Slider" value="54.8" high-value="100" name="Cash" fill="true" inverted="true" class="HUDSlider bar" style="flex-direction: row-reverse; margin-bottom: 0;">
                        <ui:Image name="Image" source="project://database/Assets/Space_Exploration_GUI_Kit/Icons/coin-512.png?fileID=2800000&amp;guid=df65a0df46f6dc04687bb5db74c11068&amp;type=3#coin-512" scale-mode="ScaleToFit" style="width: 10%; height: 100%; translate: 70% 0%; margin-right: 4px; scale: 2 2;"/>
                    </ui:Slider>
                </ui:VisualElement>
                <ui:VisualElement name="SkinCycler" style="flex-grow: 1; flex-direction: row; flex-wrap: nowrap; justify-content: center; align-self: center; align-content: center; align-items: center; width: 50%; flex-shrink: 0; height: 15%; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px;">
                    <ui:Button text="" name="SkinLeftArrow" class="CyclerArrow CyclerArrowLeft"/>
                    <ui:Label text="Select Fit" name="SkinLabel"/>
                    <ui:Button text="" name="SkinRightArrow" class="CyclerArrow CyclerArrowRight"/>
                </ui:VisualElement>
                <ui:VisualElement name="BodyCycler" style="flex-grow: 1; flex-direction: row; flex-wrap: nowrap; justify-content: center; align-self: center; align-content: center; align-items: center; flex-shrink: 1; height: 15%; width: 50%;">
                    <ui:Button text="" name="MeshLeftArrow" class="CyclerArrow CyclerArrowLeft"/>
                    <ui:Label text="Select Body Type" name="MeshLabel"/>
                    <ui:Button text="" name="MeshRightArrow" class="CyclerArrow CyclerArrowRight"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; justify-content: center; width: 417px; margin-top: 0; align-self: center; flex-direction: row; flex-wrap: nowrap; height: auto;">
            <ui:Button text="Ready" name="ReadyButton" class="button" style="align-self: center; align-content: center; margin-right: 20px; height: 40%;"/>
            <ui:Button text="Start Game" name="StartGameButton" class="button" style="align-self: center; align-content: center; margin-right: 20px; height: 40%; transition-property: all; transition-duration: 0s; transition-timing-function: ease; transition-delay: 0s;"/>
            <ui:Button text="Leave Lobby" name="LeaveButton" class="button" style="margin-right: 20px; height: 40%;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
