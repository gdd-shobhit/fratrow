<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/MainMenuStyle.uss?fileID=7433441132597879392&amp;guid=a19dac0e7ce2b3944858e48ca0245d28&amp;type=3#MainMenuStyle"/>
    <ui:VisualElement name="Container" style="flex-grow: 1; align-self: flex-start; width: 1922px; background-image: none; -unity-background-scale-mode: stretch-to-fill;">
        <ui:Label text="Frat Row" name="Header" class="header" style="-unity-font-definition: url(&quot;project://database/Assets/Space_Exploration_GUI_Kit/Fonts/Font%20Sources/static/Asap_SemiExpanded-SemiBold.ttf?fileID=12800000&amp;guid=caec50c9db582f64b82e758a38546e15&amp;type=3#Asap_SemiExpanded-SemiBold&quot;); font-size: 120px; -unity-text-align: upper-center; -unity-text-outline-width: 4px; text-shadow: 5px 5px 10px rgb(255, 255, 255); color: rgb(255, 0, 116); letter-spacing: 1px; word-spacing: 2px; background-color: rgba(255, 255, 255, 0); background-image: none;"/>
        <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; justify-content: center; width: 502px; translate: 20% 0; transform-origin: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;">
            <ui:Button text="Start" name="Start" class="button" style="align-self: center; align-content: center; background-image: url(&quot;project://database/Assets/Space_Exploration_GUI_Kit/Button_Images/Source_Image_Sprites/extra%20large/short-yellow-extra-large.png?fileID=2800000&amp;guid=c8dd6d8869346624c8adc63daa4146b9&amp;type=3#short-yellow-extra-large&quot;);"/>
            <ui:Button text="Join" name="Join" class="button" style="align-self: center; align-content: center; background-image: url(&quot;project://database/Assets/Space_Exploration_GUI_Kit/Button_Images/Source_Image_Sprites/extra%20large/short-blue-extra-large.png?fileID=2800000&amp;guid=c1186c6c57955e74286697f5a74fa36d&amp;type=3#short-blue-extra-large&quot;); background-color: rgba(188, 188, 188, 0);"/>
            <ui:Button text="Settings" name="Settings" class="button" style="background-image: url(&quot;project://database/Assets/Space_Exploration_GUI_Kit/Button_Images/Source_Image_Sprites/extra%20large/short-blue-extra-large.png?fileID=2800000&amp;guid=c1186c6c57955e74286697f5a74fa36d&amp;type=3#short-blue-extra-large&quot;); background-color: rgba(188, 188, 188, 0);"/>
        </ui:VisualElement>
        <ui:VisualElement name="JoinPanel" style="position: absolute; left: 1px; right: 2px; top: 2px; bottom: -1px; justify-content: center; align-items: center; background-color: rgba(0, 0, 0, 0.6); display: none;">
            <ui:VisualElement name="JoinPanelContent" style="flex-direction: column; align-items: center; background-color: rgba(40, 40, 40, 0.95); padding: 40px; border-radius: 12px; min-width: 320px; align-self: center; justify-content: center;">
                <ui:Label text="Enter Session Code" name="JoinPanelTitle" style="font-size: 28px; color: white; margin-bottom: 20px; width: 100%; align-items: center; align-self: center; justify-content: center; align-content: center; -unity-text-align: upper-center;"/>
                <ui:TextField name="SessionCodeField" value="" max-length="8" label="Session Code" style="width: 411px; margin-bottom: 20px; height: 74px; font-size: 24px; -unity-text-align: middle-center; justify-content: center; align-self: center; align-items: center; align-content: center; margin-top: 20px; color: rgb(255, 255, 255);"/>
                <ui:VisualElement name="JoinPanelButtons" style="flex-direction: row; justify-content: center; align-self: center; align-content: center; width: 254px; height: 85px;">
                    <ui:Button text="Join" name="JoinConfirmButton" class="button" style="margin-right: 12px; background-image: url(&quot;project://database/Assets/Space_Exploration_GUI_Kit/Button_Images/Source_Image_Sprites/extra%20large/short-yellow-extra-large.png?fileID=2800000&amp;guid=c8dd6d8869346624c8adc63daa4146b9&amp;type=3#short-yellow-extra-large&quot;); height: 70%;"/>
                    <ui:Button text="Cancel" name="JoinCancelButton" class="button" style="background-image: url(&quot;project://database/Assets/Space_Exploration_GUI_Kit/Button_Images/Source_Image_Sprites/extra%20large/short-blue-extra-large.png?fileID=2800000&amp;guid=c1186c6c57955e74286697f5a74fa36d&amp;type=3#short-blue-extra-large&quot;); height: 70%;"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
