Assets/Art/**/*.fbx filter=lfs diff=lfs merge=lfs -text
Assets/Art/**/*.png filter=lfs diff=lfs merge=lfs -text
production/qa/evidence/**/*.png filter=lfs diff=lfs merge=lfs -text
ArtSource/** !text !filter !merge !diff
Assets/Art/** !text !filter !merge !diff
production/qa/evidence/** !text !filter !merge !diff
